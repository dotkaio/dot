{
	"name": "@dotkaio/dot-storage-sqlite-node",
	"version": "0.0.1",
	"description": "Node sqlite storage backend for @dotkaio/dot-agent-core sessions",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"clean": "node -e \"import('node:fs/promises').then(fs=>fs.rm('dist',{recursive:true,force:true}))\"",
		"build": "tsgo -p tsconfig.build.json && node ./scripts/prepare-dist.mjs copy-sqlite-migrations",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"author": "dotkaio",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dotkaio/dot.git",
		"directory": "packages/storage/sqlite-node"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"@dotkaio/dot-ai": "^0.0.1",
		"@dotkaio/dot-agent-core": "^0.0.1"
	},
	"homepage": "https://github.com/dotkaio/dot#readme",
	"bugs": {
		"url": "https://github.com/dotkaio/dot/issues"
	}
}
