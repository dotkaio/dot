{
	"name": "@dotkaio/dot-protocol",
	"version": "0.0.1",
	"description": "Transport-neutral CBOR protocol for remote dot sessions",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json",
		"test": "vitest --run",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"keywords": [
		"dot",
		"protocol",
		"cbor",
		"binary",
		"framing"
	],
	"author": "dotkaio",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dotkaio/dot.git",
		"directory": "packages/protocol"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"typebox": "1.3.7"
	},
	"devDependencies": {
		"shx": "0.4.0",
		"vitest": "4.1.11"
	},
	"homepage": "https://github.com/dotkaio/dot#readme",
	"bugs": {
		"url": "https://github.com/dotkaio/dot/issues"
	}
}
