{
	"name": "@dotkaio/dot-server",
	"version": "0.0.1",
	"description": "experimental server package for dot",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./testing": {
			"types": "./dist/testing/index.d.ts",
			"import": "./dist/testing/index.js"
		},
		"./unix": {
			"types": "./dist/transports/unix/index.d.ts",
			"import": "./dist/transports/unix/index.js"
		},
		"./legacy": {
			"types": "./dist/legacy/index.d.ts",
			"import": "./dist/legacy/index.js"
		}
	},
	"bin": {
		"server": "./dist/legacy/cli.js"
	},
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"dev": "tsgo -p tsconfig.build.json --watch --preserveWatchOutput",
		"build": "tsgo -p tsconfig.build.json && shx chmod +x dist/legacy/cli.js",
		"test": "vitest --run",
		"typecheck": "tsgo -p tsconfig.test.json",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"keywords": [
		"dot",
		"server"
	],
	"author": "dotkaio",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dotkaio/dot.git",
		"directory": "packages/server"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"@dotkaio/dot-ai": "^0.0.1",
		"@dotkaio/dot": "^0.0.1",
		"@dotkaio/dot-protocol": "^0.0.1"
	},
	"devDependencies": {
		"shx": "0.4.0",
		"vitest": "4.1.9"
	},
	"homepage": "https://github.com/dotkaio/dot#readme",
	"bugs": {
		"url": "https://github.com/dotkaio/dot/issues"
	}
}
