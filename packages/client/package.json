{
	"name": "@dotkaio/dot-client",
	"version": "0.0.1",
	"description": "Transport-neutral client for remote dot sessions over framed CBOR bytes",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./unix": {
			"types": "./dist/unix.d.ts",
			"import": "./dist/unix.js"
		},
		"./package.json": "./package.json"
	},
	"sideEffects": false,
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json",
		"test": "vitest --run",
		"typecheck": "tsgo -p tsconfig.test.json",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"keywords": [
		"dot",
		"client",
		"protocol",
		"cbor",
		"binary"
	],
	"author": "dotkaio",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dotkaio/dot.git",
		"directory": "packages/client"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"@dotkaio/dot-protocol": "^0.0.1"
	},
	"devDependencies": {
		"shx": "0.4.0",
		"vitest": "4.1.9"
	},
	"homepage": "https://github.com/dotkaio/dot#readme",
	"bugs": {
		"url": "https://github.com/dotkaio/dot/issues"
	}
}
